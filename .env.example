APP_NAME="LMS Gadai Mulia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://lmsgadai-revamp.test
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Use the existing LMS connection. Do not reset or seed this database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Employee authentication and organization master data.
DB2_CONNECTION=pgsql
DB2_HOST=127.0.0.1
DB2_PORT=5432
DB2_DATABASE=
DB2_USERNAME=
DB2_PASSWORD=

SESSION_DRIVER=file
SESSION_COOKIE=lmsgadai_revamp_session
SESSION_LIFETIME=120
SESSION_DOMAIN=null
CACHE_STORE=file
CACHE_PREFIX=lmsgadai_revamp
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LMS_UPLOAD_ROOT=C:/laragon/www/lmsgadai/storage/app/public
LOG_CHANNEL=stack
LOG_LEVEL=debug
MAIL_MAILER=log
