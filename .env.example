APP_NAME="LMS Gadai Mulia"
APP_ENV=local
LOGIN_BYPASS=false
APP_KEY=
APP_DEBUG=true
APP_URL=http://lmsgadai-revamp.test
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Use the existing LMS connection. Do not reset or seed this database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Employee authentication and organization master data.
DB2_CONNECTION=pgsql
DB2_HOST=127.0.0.1
DB2_PORT=5432
DB2_DATABASE=
DB2_USERNAME=
DB2_PASSWORD=

SESSION_DRIVER=file
SESSION_COOKIE=lmsgadai_revamp_session
SESSION_LIFETIME=120
SESSION_DOMAIN=null
CACHE_STORE=file
CACHE_PREFIX=lmsgadai_revamp
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LMS_UPLOAD_ROOT=C:/laragon/www/lmsgadai/storage/app/public
# Set to s3 after copying legacy storage/app contents to the bucket.
LMS_STORAGE_DRIVER=local
MINIO_PUBLIC_PREFIX=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# S3 API endpoint, not the MinIO web console.
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
LOG_CHANNEL=stack
LOG_LEVEL=debug
MAIL_MAILER=log
# EmailService uses the Resend HTTP API directly; see docs/EMAIL.md.
RESEND_API_KEY=
# RESEND_FROM_ADDRESS=onboarding@resend.dev
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="LMS Gadai Mulia"
MAIL_TIMEOUT=20
