{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client"]
  },
  "include": [
    "resources/js/env.d.ts",
    "resources/js/api/**/*.ts",
    "resources/js/services/**/*.ts",
    "resources/js/utils/axios.ts",
    "tests/types/**/*.ts"
  ]
}
